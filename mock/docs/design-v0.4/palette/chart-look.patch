+  --chart-separator-width: 2px;          /* one paper gap between every two segments; no outlines */
+  --chart-budget-line-width: 1px;        /* the budget is a reference, not a mark */
+  --color-budget-line: var(--color-text-secondary);
+  --chart-today-line-width: 2px;         /* C10 Today lines wide enough to show their hue */
+  --chart-frontier-line-width: 3px;      /* C10 InfraVana: the heaviest line on the page */
+}
